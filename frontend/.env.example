# Backend HTTP API base URL (FastAPI server when running Stage 1+ backend)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket base URL (FastAPI WebSocket server for Stage 8+ realtime sync)
VITE_WS_BASE_URL=ws://localhost:8000

# Default transport mode: "simulated" (in-browser engine) or "remote" (FastAPI backend)
VITE_DEFAULT_TRANSPORT_MODE=simulated
